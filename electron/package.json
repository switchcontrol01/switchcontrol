{
  "name": "switchcontrol-electron",
    "version": "1.1.1",
  "description": "Elite Windows performance optimization suite",
  "author": "SwitchTech",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "prebuild": "node -e \"const f=require('fs'),p=require('path'),base=process.cwd();const run=s=>{const sp=p.join(base,'scripts',s+'.js');if(f.existsSync(sp)){require(sp);}else{console.warn('[prebuild] '+s+'.js not found — using inline fallback');}};run('ensure-assets');const distSp=p.join(base,'scripts','ensure-dist.js');if(f.existsSync(distSp)){require(distSp);}else{const src=p.join(base,'..','dist');const dst=p.join(base,'dist-frontend');if(!f.existsSync(src)){console.error('[prebuild] dist/ not found — run npm run build first');process.exit(1);}f.rmSync(dst,{recursive:true,force:true});f.cpSync(src,dst,{recursive:true});const cjs=p.join(dst,'index.cjs');if(f.existsSync(cjs))f.rmSync(cjs);console.log('[prebuild] dist-frontend synced (inline fallback)');}\"",
    "build:native": "node -e \"const f=require('fs'),p=require('path');const sp=p.join(process.cwd(),'scripts','build-native.js');if(f.existsSync(sp)){require(sp);}else{console.warn('[build:native] build-native.js not found — skipping (existing bin/sc_memory.exe will be used)');}\"",
    "dist:win": "npm run prebuild && npm run build:native && electron-builder --win",
    "generate-latest-yml": "node scripts/generate-latest-yml.js",
    "sync-version": "node scripts/sync-version.js",
    "release": "node -e \"const f=require('fs'),p=require('path');const sp=p.join(process.cwd(),'scripts','release.js');if(f.existsSync(sp)){require(sp);}else{console.error('[release] release.js not found.\\nFix: run git pull in the SwitchControl directory to download the release script, then retry.');process.exit(1);}\""
  },
  "dependencies": {
    "systeminformation": "^5.23.5",
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.switchcontrol.app",
    "productName": "SwitchControl",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "user-data-paths.js",
      "file-logger.js",
      "tweak-executor.js",
      "network-tweak-executor.js",
      "slider-tweak-executor.js",
      "nic-executor.js",
      "power-plan-manager.js",
      "premium-revert-pipeline.js",
      "ownership-store.js",
      "backend-launcher.js",
      "config-store.js",
      "critical-logger.js",
      "security-helper.js",
      "debloat-helper.js",
      "cleaner-helper.js",
      "focus-helper.js",
      "process-control.js",
      "powershell-limiter.js",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/semver/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "!native/**",
      "!scripts/**",
      "!sensors-helper/**",
      "!executors/**",
      "!build/**",
      "!dist-frontend/**",
      "!dist/**",
      "!*.md",
      "!*.txt",
      "!tweak-audit-report.json",
      "!node_modules/.cache/**",
      "!node_modules/.bin/**"
    ],
    "extraResources": [
      {
        "from": "dist-frontend",
        "to": "dist",
        "filter": [
          "**/*",
          "!google*.html",
          "!sitemap.xml",
          "!robots.txt",
          "!og-image.png",
          "!opengraph.jpg",
          "!android-chrome-*.png",
          "!*.md",
          "!*.txt"
        ]
      },
      {
        "from": "../dist/index.cjs",
        "to": "dist/index.cjs"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ws",
        "to": "dist/node_modules/ws"
      },
      {
        "from": "node_modules/systeminformation",
        "to": "dist/node_modules/systeminformation"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-c4010f9528c14cbd9848f2c9c7c2306d.r2.dev"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "SwitchControl",
      "warningsAsErrors": true
    }
  }
}
