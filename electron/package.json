{
  "name": "switchcontrol-electron",
  "version": "1.0.0",
  "description": "Elite Windows performance optimization suite",
  "author": "SwitchTech",
  "private": true,
  "main": "main.js",
  "type": "commonjs",

  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/ensure-assets.js && node scripts/ensure-dist.js",
    "build:native": "node scripts/build-native.js",
    "dist:win": "npm run prebuild && npm run build:native && electron-builder --win"
  },

  "dependencies": {
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },

  "build": {
    "appId": "com.switchcontrol.app",
    "productName": "SwitchControl",

    "directories": {
      "output": "dist",
      "buildResources": "build"
    },

    "files": [
      "main.js",
      "preload.js",
      "tweak-executor.js",
      "backend-launcher.js",
      "config-store.js",
      "node_modules/systeminformation/**/*"
    ],

    "extraResources": [
      {
        "from": "dist-frontend",
        "to": "dist"
      },
      {
        "from": "../dist/index.cjs",
        "to": "dist/index.cjs"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],

    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },

    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
