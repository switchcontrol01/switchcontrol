{
  "name": "switchcontrol-electron",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "type": "commonjs",

  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },

  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },

  "build": {
    "appId": "com.switchcontrol.app",
    "productName": "SwitchControl",

    "directories": {
      "output": "dist",
      "buildResources": "build"
    },

    "files": [
      "main.js",
      "preload.js"
    ],

    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],

    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },

    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
