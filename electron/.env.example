# Cloudflare R2 credentials for release uploads
# Copy this file to .env and fill in your values
# .env is gitignored — never commit real credentials

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=switchcontrol-releases

# Public URL used for post-upload verification and printed output.
# Default (temporary bridge): Cloudflare R2 dev URL — already set in release.js.
# When releases.switchcontrol.org is ready, uncomment this AND update
# build.publish.url in electron/package.json to the same value.
# R2_PUBLIC_URL=https://releases.switchcontrol.org
