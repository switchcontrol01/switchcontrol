# Cloudflare R2 credentials for release uploads
# Copy this file to .env and fill in your values:
#
#   PowerShell:  Copy-Item .env.example .env
#   cmd:         copy .env.example .env
#
# .env is gitignored — never commit real credentials

# Cloudflare account ID (dash.cloudflare.com → top-right account menu → Account ID)
R2_ACCOUNT_ID=

# R2 API token — create at dash.cloudflare.com → R2 → Manage R2 API Tokens
# Grant: Object Read & Write on bucket "switchcontrol-releases"
# Copy the Access Key ID and Secret Access Key shown once on creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name (must match what you created in R2)
R2_BUCKET=switchcontrol-releases

# Public URL used for post-upload verification output.
# Must match build.publish.url in electron/package.json.
R2_PUBLIC_URL=https://pub-c4010f9528c14cbd9848f2c9c7c2306d.r2.dev
