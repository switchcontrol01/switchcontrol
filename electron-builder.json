{
  "appId": "com.switchcontrol.desktop",
  "productName": "Switchcontrol",
  "executableName": "Switchcontrol",
  "copyright": "Copyright © 2026 SwitchTech",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/native/**",
    "!electron/scripts/**",
    "!electron/sensors-helper/**",
    "!electron/executors/**",
    "!electron/build/**",
    "!electron/dist-frontend/**",
    "!electron/dist/**",
    "!electron/*.md",
    "!electron/*.txt",
    "!electron/tweak-audit-report.json",
    "!attached_assets/**",
    "!screenshots/**",
    "!docs/**",
    "!assets/**",
    "!public/**",
    "!client/**",
    "!server/**",
    "!shared/**",
    "!migrations/**",
    "!scripts/**",
    "!script/**",
    "!.local/**",
    "!.git/**",
    "!*.md",
    "!*.txt",
    "!*.ts",
    "!*.bat",
    "!tmp_*",
    "!drizzle.config.ts",
    "!vite.config.ts",
    "!postcss.config.js",
    "!tsconfig.json",
    "!components.json",
    "!skills-lock.json",
    "!threat_model.md"
  ],
  "extraResources": [
    {
      "from": "electron/bin",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "publish": {
    "provider": "generic",
    "url": "https://pub-c4010f9528c14cbd9848f2c9c7c2306d.r2.dev/"
  },
  "win": {
    "target": "nsis",
    "icon": "dist/app-icon.ico",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Switchcontrol"
  }
}
