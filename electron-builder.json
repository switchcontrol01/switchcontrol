{
  "appId": "com.switchcontrol.desktop",
  "productName": "SwitchControl",
  "executableName": "SwitchControl",
  "description": "Elite Windows performance optimization suite",
  "author": "SwitchTech",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "dist/app-icon.ico",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "SwitchControl"
  }
}
