{
  "appId": "com.switchcontrol.desktop",
  "productName": "Switchcontrol",
  "executableName": "Switchcontrol",
  "copyright": "Copyright © 2026 SwitchTech",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "electron/bin",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "publish": {
    "provider": "generic",
    "url": "https://pub-c4010f9528c14cbd9848f2c9c7c2306d.r2.dev/"
  },
  "win": {
    "target": "nsis",
    "icon": "dist/app-icon.ico",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Switchcontrol"
  }
}
