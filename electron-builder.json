{
  "appId": "org.switchcontrol.app",
  "productName": "SwitchControl",
  "copyright": "Copyright © 2024 SwitchControl",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/public/**/*",
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "build/",
      "to": "build/"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "SwitchControl-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SwitchControl",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "installerSidebar": "build/installer/installer-sidebar.bmp",
    "installerHeader": "build/installer/installer-header.bmp"
  },
  "protocols": [
    {
      "name": "SwitchControl Protocol",
      "schemes": ["switchcontrol"]
    }
  ]
}
